{
  "name": "@locus/desktop",
  "version": "0.18.0",
  "private": true,
  "author": "Locus contributors",
  "license": "MIT",
  "description": "Locus — local AI coding agents in real guest VMs",
  "homepage": "https://github.com/Modsofthenation/Locus#readme",
  "desktopName": "locus",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ./scripts/bundle-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "capture:readme": "node ./scripts/capture-readme-screens.mjs",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux:arm64": "npm run build && electron-builder --linux --arm64 --publish never"
  },
  "dependencies": {
    "@locus/shared": "*",
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.locus.desktop",
    "productName": "Locus",
    "executableName": "locus",
    "electronVersion": "45.2.2",
    "copyright": "Copyright (c) 2026 Locus contributors",
    "directories": {
      "output": "dist-electron",
      "buildResources": "buildResources"
    },
    "icon": "buildResources/icon.png",
    "files": [
      "electron/**/*.cjs",
      "package.json",
      "buildResources/icon.png"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "ui"
      },
      {
        "from": "build/server",
        "to": "server"
      },
      {
        "from": "build/server-typescript-ls",
        "to": "server/node_modules/typescript-ls"
      },
      {
        "from": "../../images",
        "to": "images"
      },
      {
        "from": "../../apps/chrome-extension",
        "to": "chrome-extension"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Locus",
      "executableName": "locus"
    },
    "deb": {
      "packageName": "locus",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "rpm": {
      "packageName": "locus",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
