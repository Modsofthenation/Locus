{
  "name": "@locus/worker",
  "version": "0.19.0",
  "private": true,
  "description": "LAN/cloud worker that runs Docker, Host, and QEMU guests for a Locus control plane",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@locus/guest-agent": "*",
    "@locus/hypervisor": "*",
    "@locus/shared": "*",
    "hono": "^4.13.13",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
